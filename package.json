{
  "name": "ssh-control",
  "productName": "SSH Control",
  "version": "1.2.0",
  "description": "Хранилище SSH-ключей и данных серверов для macOS",
  "main": "main/main.js",
  "author": "Aleksey",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "check:lines": "node scripts/check-line-limit.js",
    "coverage": "c8 npm test",
    "package": "electron-builder --mac --dir",
    "dist": "electron-builder --mac"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/xterm": "^5.5.0",
    "c8": "^12.0.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.sshcontrol.app",
    "productName": "SSH Control",
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  }
}
